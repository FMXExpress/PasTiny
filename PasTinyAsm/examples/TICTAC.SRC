ECHO Tic-tac-toe
ECHO 1=X 4=O 0=empty:LET T=1
ECHO Squares 1-9 in row order
FOREVER
NUMBER A:PRINT |:NUMBER B:PRINT |:OUT C
NUMBER D:PRINT |:NUMBER E:PRINT |:OUT F
NUMBER G:PRINT |:NUMBER H:PRINT |:OUT I
IF T=1:ECHO X turn:ELSE:ECHO O turn:END
ECHO Choose a square or 0 to quit
INPUT P:IF P=0:STOP:END:LET M=0
IF P=1:IF A=0:LET A=T:LET M=1:END:END
IF P=2:IF B=0:LET B=T:LET M=1:END:END
IF P=3:IF C=0:LET C=T:LET M=1:END:END
IF P=4:IF D=0:LET D=T:LET M=1:END:END
IF P=5:IF E=0:LET E=T:LET M=1:END:END
IF P=6:IF F=0:LET F=T:LET M=1:END:END
IF P=7:IF G=0:LET G=T:LET M=1:END:END
IF P=8:IF H=0:LET H=T:LET M=1:END:END
IF P=9:IF I=0:LET I=T:LET M=1:END:END
IF M=0
ECHO Invalid move. Try again.
ELSE
LET N=N+1
LET S=A+B+C:IF S=3:LET W=1:END:IF S=12:LET W=1:END
LET S=D+E+F:IF S=3:LET W=1:END:IF S=12:LET W=1:END
LET S=G+H+I:IF S=3:LET W=1:END:IF S=12:LET W=1:END
LET S=A+D+G:IF S=3:LET W=1:END:IF S=12:LET W=1:END
LET S=B+E+H:IF S=3:LET W=1:END:IF S=12:LET W=1:END
LET S=C+F+I:IF S=3:LET W=1:END:IF S=12:LET W=1:END
LET S=A+E+I:IF S=3:LET W=1:END:IF S=12:LET W=1:END
LET S=C+E+G:IF S=3:LET W=1:END:IF S=12:LET W=1:END
IF W=1
IF T=1:ECHO X wins!:ELSE:ECHO O wins!:END
STOP
END
IF N=9:ECHO Draw!:STOP:END
LET T=5-T
END
END
