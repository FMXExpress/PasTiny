ECHO Go 9x9. 1=Black 2=White 0=empty
ECHO Enter row and column as two digits. 0 passes. 100 quits.
FOR I=0 TO 120:PUT I 3:NEXT
FOR R=1 TO 9:FOR S=1 TO 9:PUT R*11+S 0:NEXT:NEXT
LET P=1
FOREVER
ECHO    1 2 3 4 5 6 7 8 9
FOR R=9 DOWNTO 1
NUMBER R:PRINT |
FOR S=1 TO 9:GET V R*11+S:NUMBER V:PRINT |:NEXT
NL
NEXT
PRINT Player:NUMBER P:NL
INPUT A
IF A=100:STOP:END
IF A=0
LET F=F+1
FOR I=0 TO 120:GET V I:PUT 242+I V:NEXT
LET U=1
IF F=2
LET X=0:LET Y=0
FOR I=0 TO 120:PUT 363+I 0:NEXT
FOR I=0 TO 120
GET C I
IF C=1:LET X=X+1:END:IF C=2:LET Y=Y+1:END
IF C=0
GET M 363+I
IF M=0
LET H=0:LET T=1:PUT 484 I:PUT 363+I 1
LET E=0:LET B=0:LET W=0
FOR H=0 TO 120
IF H<T
GET J 484+H
LET K=J-1:GET V K
IF V=C
GET M 363+K
IF M=0:PUT 363+K 1:PUT 484+T K:LET T=T+1:END
ELSE
IF V=0:LET E=1:END:IF V=1:LET B=1:END:IF V=2:LET W=1:END
END
LET K=J+1:GET V K
IF V=C
GET M 363+K
IF M=0:PUT 363+K 1:PUT 484+T K:LET T=T+1:END
ELSE
IF V=0:LET E=1:END:IF V=1:LET B=1:END:IF V=2:LET W=1:END
END
LET K=J-11:GET V K
IF V=C
GET M 363+K
IF M=0:PUT 363+K 1:PUT 484+T K:LET T=T+1:END
ELSE
IF V=0:LET E=1:END:IF V=1:LET B=1:END:IF V=2:LET W=1:END
END
LET K=J+11:GET V K
IF V=C
GET M 363+K
IF M=0:PUT 363+K 1:PUT 484+T K:LET T=T+1:END
ELSE
IF V=0:LET E=1:END:IF V=1:LET B=1:END:IF V=2:LET W=1:END
END
END
NEXT
IF B=1:IF W=0:LET X=X+T:END:END
IF W=1:IF B=0:LET Y=Y+T:END:END
END
END
NEXT
PRINT Black:OUT X
PRINT White:NUMBER Y+6:ECHO .5
IF X>Y+6:ECHO Black wins!:ELSE:ECHO White wins!:END
STOP
END
LET P=3-P
ELSE
LET R=A/10:LET S=A-R*10:LET A=0
IF R>0:IF R<10:IF S>0:IF S<10:LET A=R*11+S:END:END:END:END
GET V A
IF V=0
FOR I=0 TO 120:GET V I:PUT 121+I V:NEXT
PUT A P
LET Q=3-P:LET L=1:LET Z=0
FOR D=1 TO 2
FOR I=0 TO 120:PUT 363+I 0:NEXT
FOR I=0 TO 120
GET C I
IF C=Q
GET M 363+I
IF M=0
LET H=0:LET T=1:PUT 484 I:PUT 363+I 1
LET E=0:LET B=0:LET W=0
FOR H=0 TO 120
IF H<T
GET J 484+H
LET K=J-1:GET V K
IF V=C
GET M 363+K
IF M=0:PUT 363+K 1:PUT 484+T K:LET T=T+1:END
ELSE
IF V=0:LET E=1:END:IF V=1:LET B=1:END:IF V=2:LET W=1:END
END
