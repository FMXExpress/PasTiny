ECHO Chess. Uppercase white, lowercase black.
ECHO Enter from and to as row-column pairs. 0 quits.
PUT 11 4:PUT 12 2:PUT 13 3:PUT 14 5
PUT 15 6:PUT 16 3:PUT 17 2:PUT 18 4
FOR I=1 TO 8:PUT 20+I 1:PUT 70+I 9:GET V 10+I:PUT 80+I V+8:NEXT
LET P=0
FOREVER
ECHO   1 2 3 4 5 6 7 8
FOR I=8 DOWNTO 1
NUMBER I:PRINT |
FOR J=1 TO 8
GET V I*10+J
IF V=0:PRINT .:END:IF V=1:PRINT P:END:IF V=9:PRINT p:END
IF V=2:PRINT N:END:IF V=3:PRINT B:END:IF V=10:PRINT n:END
IF V=4:PRINT R:END:IF V=5:PRINT Q:END:IF V=11:PRINT b:END
IF V=6:PRINT K:END:IF V=12:PRINT r:END:IF V=13:PRINT q:END
IF V=14:PRINT k:END:PRINT |
NEXT
NL
NEXT
IF P=0:ECHO White:ELSE:ECHO Black:END
INPUT X
IF X=0:STOP:END
INPUT Y
LET R=X/10:LET S=X-R*10:LET T=Y/10:LET U=Y-T*10
LET L=0
IF R>0:IF R<9:IF S>0:IF S<9:LET L=1:END:END:END:END
IF T=0:LET L=0:END:IF T>8:LET L=0:END
IF U=0:LET L=0:END:IF U>8:LET L=0:END
IF L=1
GET Z X:GET W Y:LET L=0:LET F=0
FOR H=0 TO 1
IF H=0
LET A=X:LET B=Y:LET C=P:LET E=X
ELSE
LET A=11:LET E=88:LET C=1-P:LET B=0
FOR I=11 TO 88:GET V I:IF V=6+P*8:LET B=I:END:NEXT
END
FOR A=A TO E
GET V A:GET D B
IF V>0
IF V/8=C
IF A<>B
IF D=0:LET K=1:ELSE:LET K=0:IF D/8<>C:LET K=1:END:END
IF H=0:IF D-D/8*8=6:LET K=0:END:END
IF K=1
LET R=A/10:LET S=A-R*10:LET T=B/10:LET U=B-T*10
IF R>T:LET I=R-T:LET G=0-10:ELSE:LET I=T-R:LET G=10:END
IF S>U:LET J=S-U:LET M=0-1:ELSE:LET J=U-S:LET M=1:END
IF I=0:LET G=0:END:IF J=0:LET M=0:END
LET V=V-C*8:LET K=0
IF V=1
IF C=0:LET N=R+1:LET O=2:ELSE:LET N=R-1:LET O=7:END
IF T=N:IF J=1:IF D>0:LET K=1:END:END:END
IF J=0
IF D=0
IF T=N:LET K=1:END
IF R=O:IF I=2:GET N A+G:IF N=0:LET K=1:END:END:END
END
END
END
IF V=2:IF I*J=2:LET K=1:END:END
IF V=6:IF I<2:IF J<2:LET K=1:END:END:END
IF V>2
IF V<6
IF V<>4:IF I=J:LET K=1:END:END
IF V<>3:IF I*J=0:LET K=1:END:END
IF K=1
LET N=A+G+M
FOR O=1 TO 7
IF N<>B:GET D N:IF D>0:LET K=0:END:LET N=N+G+M:END
NEXT
END
END
END
IF K=1:IF H=0:LET L=1:ELSE:LET F=1:END:END
END
END
END
END
NEXT
IF H=0
IF L=1
PUT X 0:PUT Y Z
IF Z=1:IF Y>80:PUT Y 5:END:END
IF Z=9:IF Y<20:PUT Y 13:END:END
END
END
NEXT
IF L=1
IF F=1:PUT X Z:PUT Y W:ECHO King would be in check.:ELSE:LET P=1-P:END
ELSE
ECHO Illegal move.
END
ELSE
ECHO Invalid square.
END
END
