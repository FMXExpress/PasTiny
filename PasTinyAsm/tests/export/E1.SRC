FOR I=1 TO 5:OUT I*I:NEXT
LET S=0:FOR I=1 TO 100:LET S=S+I:NEXT:OUT S
LET X=2+3*4:OUT X:LET Y=X*X/7-1:OUT Y
LET A=3:LET B=5:OUT A-B:IF A-B>60000:ECHO wrapped:END
TIMES 2
FOR X=3 DOWNTO 1
NUMBER X:PRINT  and
NEXT
NEWLINE
END
IF X=0
ECHO it's zero
ELSE
ECHO not zero
END
PRINT "Bye, now: done"
REPEAT 2
